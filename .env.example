# Local preview is non-indexable and non-purchasable.
SHOPIFY_MODE=preview
SHOPIFY_STORE_DOMAIN=nilkurinji-jcqze5tu.myshopify.com
SHOPIFY_API_VERSION=2026-10
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Set SITE_URL to the exact current origin in each environment.
SITE_URL=http://localhost:3000

# Keep these blank until live account/cart flows are configured.
CART_COOKIE_SECRET=
CUSTOMER_SESSION_SECRET=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=
REVALIDATE_SECRET=

# Provider is unselected. Do not enable checkout until end-to-end tests pass.
CHECKOUT_PROVIDER=
CHECKOUT_ATTEMPT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHOPIFY_CHECKOUT_ENABLED=false
SHOPIFY_CHECKOUT_FALLBACK_ENABLED=false
SHOPIFY_CHECKOUT_ALLOWED_HOSTS=

# Indexing is gated independently from checkout.
SHOPIFY_INDEXING_ENABLED=false
